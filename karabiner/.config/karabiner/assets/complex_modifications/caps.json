{
    "title": "Caps Lock",
    "rules": [
        {
            "description": "Caps to cmd unless in terminal then ctrl, plus swap opt/cmd in Ghostty",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "com.mitchellh.ghostty",
                                "com.raphaelamorim.rio"
                            ],
                            "type": "frontmost_application_unless"
                        }
                    ],
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [
                        {
                            "key_code": "left_gui",
                            "repeat": true
                        }
                    ],
                    "to_if_alone": [
                        { "set_variable": { "name": "caps_word", "value": 0 } },
                        { "set_notification_message": { "id": "caps_word", "text": "" } },
                        {
                            "key_code": "escape",
                            "repeat": true
                        }
                    ],
                    "type": "basic"
                },
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "com.mitchellh.ghostty",
                                "com.raphaelamorim.rio"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [
                        {
                            "key_code": "left_control",
                            "repeat": true
                        }
                    ],
                    "to_if_alone": [
                        { "set_variable": { "name": "caps_word", "value": 0 } },
                        { "set_notification_message": { "id": "caps_word", "text": "" } },
                        {
                            "key_code": "escape",
                            "repeat": true
                        }
                    ],
                    "type": "basic"
                }
            ]
        }
    ]
}
